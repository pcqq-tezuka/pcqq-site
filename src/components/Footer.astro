---
const year = new Date().getFullYear();

const footerLinks = [
  { href: '/symptoms', label: '症状から探す' },
  { href: '/services', label: 'サービス一覧' },
  { href: '/areas',    label: 'エリア' },
  { href: '/pricing',  label: '料金' },
  { href: '/profile',  label: '手塚信哉について' },
  { href: '/faq',      label: 'よくある質問' },
  { href: '/voices',   label: 'お客様の声' },
  { href: '/blog',     label: 'ブログ' },
  { href: '/contact',  label: 'お問い合わせ' },
];
---

<footer class="bg-gray-900 text-gray-300 mt-20" role="contentinfo">
  <div class="max-w-6xl mx-auto px-4 py-12">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-10">

      <!-- ブランド情報 -->
      <div>
        <p class="text-white text-xl font-bold mb-1">PCQQ パソコン修理</p>
        <p class="text-gray-400 text-sm mb-3">手塚信哉</p>
        <p class="text-sm leading-relaxed">
          大分県宇佐市・豊後高田市・中津市<br>
          および周辺エリア出張対応
        </p>
        <a
          href="tel:05031599587"
          class="inline-flex items-center gap-2 mt-4 text-yellow-400 hover:text-yellow-300 font-bold text-xl transition-colors"
          aria-label="電話: 050-3159-9587"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.61 21 3 13.39 3 4c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.24 1.02l-2.21 2.2z"/>
          </svg>
          050-3159-9587
        </a>
      </div>

      <!-- サイトマップ -->
      <div>
        <p class="text-white font-bold mb-4 text-base" id="footer-nav-label">サイトマップ</p>
        <nav aria-labelledby="footer-nav-label">
          <ul role="list" class="grid grid-cols-2 gap-x-4 gap-y-2">
            {footerLinks.map(item => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-gray-400 hover:text-white transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- お問い合わせ -->
      <div>
        <p class="text-white font-bold mb-4 text-base">お気軽にご相談ください</p>
        <div class="flex flex-col gap-3">
          <a
            href="tel:05031599587"
            class="flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-4 rounded-xl font-bold text-lg transition-colors min-h-[56px]"
            aria-label="電話でお問い合わせ: 050-3159-9587"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.61 21 3 13.39 3 4c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.24 1.02l-2.21 2.2z"/>
            </svg>
            電話する
          </a>
          <a
            href="http://line.me/ti/p/%40cbe1836f"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white px-4 py-4 rounded-xl font-bold text-lg transition-colors min-h-[56px]"
            aria-label="LINEでお問い合わせ（新しいタブで開きます）"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.105.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
            </svg>
            LINE で相談する
          </a>
          <a
            href="/contact"
            class="flex items-center justify-center gap-2 bg-gray-600 hover:bg-gray-500 text-white px-4 py-4 rounded-xl font-bold text-lg transition-colors min-h-[56px]"
            aria-label="メールフォームでお問い合わせ"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <polyline points="2,4 12,13 22,4"/>
            </svg>
            メールで問い合わせ
          </a>
        </div>
      </div>
    </div>

    <!-- コピーライト -->
    <div class="border-t border-gray-700 pt-6 text-center">
      <p class="text-sm text-gray-500">
        © {year} PCQQ パソコン修理 手塚信哉. All rights reserved.
      </p>
    </div>
  </div>
</footer>
