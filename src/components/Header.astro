---
const PHONE = '050-3159-9587';
const PHONE_TEL = 'tel:05031599587';

const navItems = [
  { href: '/symptoms', label: '症状から探す' },
  { href: '/services', label: 'サービス' },
  { href: '/areas',    label: 'エリア' },
  { href: '/pricing',  label: '料金' },
  { href: '/faq',      label: 'よくある質問' },
  { href: '/voices',   label: 'お客様の声' },
  { href: '/blog',     label: 'ブログ' },
  { href: '/contact',  label: 'お問い合わせ' },
];
---

<header class="sticky top-0 z-50 bg-white shadow-md">
  <div class="max-w-6xl mx-auto px-4">

    <!-- ヘッダー上段: ロゴ / デスクトップNav / 電話 / ハンバーガー -->
    <div class="flex items-center justify-between gap-3 h-16">

      <!-- ロゴ -->
      <a href="/" class="shrink-0" aria-label="PCQQパソコン修理 トップページへ">
         <img
           src="/images/logo_03.png"
           alt="PCQQ パソコン訪問修理"
           width="250"
           height="34"
           class="w-[250px] h-[34px]"
         />
      </a>

      <!-- デスクトップ ナビゲーション -->
      <nav
        class="hidden md:flex items-center gap-5 flex-1 justify-center"
        aria-label="メインナビゲーション"
      >
        {navItems.map(item => (
          <a
            href={item.href}
            class="text-gray-700 hover:text-blue-600 font-medium transition-colors text-sm whitespace-nowrap"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- デスクトップ 電話ボタン -->
      <a
        href={PHONE_TEL}
        class="hidden md:flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-full font-bold text-base transition-colors shrink-0"
        aria-label={`電話でお問い合わせ: ${PHONE}`}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.61 21 3 13.39 3 4c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.24 1.02l-2.21 2.2z"/>
        </svg>
        {PHONE}
      </a>

      <!-- モバイル ハンバーガーボタン -->
      <button
        id="menu-btn"
        type="button"
        class="md:hidden flex items-center justify-center w-11 h-11 rounded-lg text-gray-700 hover:bg-gray-100 transition-colors"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="メニューを開く"
      >
        <!-- 開くアイコン -->
        <svg id="icon-open" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6"  x2="21" y2="6"  />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <!-- 閉じるアイコン -->
        <svg id="icon-close" class="hidden" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <!-- モバイル 電話ボタン（常時表示） -->
    <div class="md:hidden pb-2">
      <a
        href={PHONE_TEL}
        class="flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white py-3 rounded-xl font-bold text-lg w-full transition-colors"
        aria-label={`電話でお問い合わせ: ${PHONE}`}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.61 21 3 13.39 3 4c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.24 1.02l-2.21 2.2z"/>
        </svg>
        <span>{PHONE}</span>
      </a>
    </div>
  </div>

  <!-- モバイル ドロップダウンナビ -->
  <div
    id="mobile-nav"
    class="hidden md:hidden bg-white border-t border-gray-200"
    aria-label="モバイルナビゲーション"
  >
    <nav>
      <ul role="list">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class="flex items-center px-6 py-4 text-gray-800 hover:bg-blue-50 hover:text-blue-700 text-lg font-medium border-b border-gray-100 transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn  = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-nav');
  const iconOpen  = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      const isOpen = !menu.classList.contains('hidden');

      btn.setAttribute('aria-expanded', String(isOpen));
      btn.setAttribute('aria-label', isOpen ? 'メニューを閉じる' : 'メニューを開く');
      iconOpen?.classList.toggle('hidden', isOpen);
      iconClose?.classList.toggle('hidden', !isOpen);
    });

    // ナビリンクをクリックしたらメニューを閉じる
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'メニューを開く');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      });
    });
  }
</script>
