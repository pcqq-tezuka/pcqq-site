---
interface BreadcrumbItem {
  label: string;
  href?: string;
}
interface Props {
  items: BreadcrumbItem[];
}
const { items } = Astro.props;
---

<nav aria-label="パンくずリスト" class="py-3">
  <ol
    class="flex items-center gap-1.5 text-sm text-gray-500 flex-wrap"
    itemscope
    itemtype="https://schema.org/BreadcrumbList"
  >
    {items.map((item, index) => (
      <li
        class="flex items-center gap-1.5"
        itemprop="itemListElement"
        itemscope
        itemtype="https://schema.org/ListItem"
      >
        {item.href ? (
          <a
            href={item.href}
            class="hover:text-blue-600 transition-colors underline underline-offset-2"
            itemprop="item"
          >
            <span itemprop="name">{item.label}</span>
          </a>
        ) : (
          <span class="text-gray-700 font-medium" itemprop="name">{item.label}</span>
        )}
        <meta itemprop="position" content={String(index + 1)} />
        {index < items.length - 1 && (
          <svg
            width="12" height="12" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true" class="text-gray-400 shrink-0"
          >
            <path d="M9 18l6-6-6-6"/>
          </svg>
        )}
      </li>
    ))}
  </ol>
</nav>
