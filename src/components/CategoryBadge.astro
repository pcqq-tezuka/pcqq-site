---
interface Props {
  slug?: string;
  name?: string;
}

const BADGE: Record<string, { label: string; cls: string }> = {
  scam: { label: 'サポート詐欺対策', cls: 'bg-red-100 text-red-700 ring-1 ring-inset ring-red-200' },
  case: { label: '修理事例',         cls: 'bg-blue-100 text-blue-700 ring-1 ring-inset ring-blue-200' },
  tips: { label: 'お役立ち情報',     cls: 'bg-green-100 text-green-700 ring-1 ring-inset ring-green-200' },
  news:        { label: 'お知らせ',         cls: 'bg-gray-100 text-gray-600 ring-1 ring-inset ring-gray-200' },
  information: { label: 'お知らせ',         cls: 'bg-gray-100 text-gray-600 ring-1 ring-inset ring-gray-200' },
};

const DEFAULT_CLS = 'bg-gray-100 text-gray-600 ring-1 ring-inset ring-gray-200';

const { slug, name } = Astro.props;
const badgeFromMap = slug ? BADGE[slug] : null;
const label = badgeFromMap?.label ?? name;
const cls = badgeFromMap?.cls ?? DEFAULT_CLS;
---

{slug && label && (
  <a
    href={`/blog/category/${slug}`}
    class={`inline-block text-xs font-semibold px-3 py-1 rounded-full ${cls} hover:opacity-75 transition-opacity`}
  >
    {label}
  </a>
)}
