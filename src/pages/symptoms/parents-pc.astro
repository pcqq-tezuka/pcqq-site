---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CallToAction from '../../components/CallToAction.astro';
---

<Layout
  title="親のPC・高齢者サポート | PCQQ パソコン修理"
  description="操作方法がわからない・メールの設定をしてほしい・動画を見られるようにしたい。高齢者のパソコンサポートは大分県宇佐市のPCQQへ。丁寧にお教えします。"
>
  <article class="max-w-3xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: '困った症状から探す', href: '/symptoms' },
      { label: '親のPC・高齢者サポート' },
    ]} />

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-3 mb-2">
      親のPC・高齢者サポート
    </h1>
    <p class="text-gray-500 mb-8">操作がわからない・設定を手伝ってほしい・使いやすくしてほしい</p>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">こんなお悩みはありませんか？</h2>
      <ul class="space-y-2">
        {[
          '親がパソコンの操作がわからなくて困っている',
          'メールの設定・使い方を教えてほしい',
          'Zoomやビデオ通話を使えるようにしたい',
          '文字が小さくて見づらい・使いやすく設定してほしい',
          '詐欺メール・偽警告に引っかかりそうで心配',
          '離れて暮らしていて親のパソコンを見てあげられない',
        ].map(item => (
          <li class="flex items-start gap-2 text-gray-700">
            <span class="text-blue-500 mt-0.5 shrink-0">✓</span>
            {item}
          </li>
        ))}
      </ul>
    </section>

    <!-- PCQQからのメッセージ -->
    <section class="mb-10 bg-blue-50 rounded-2xl p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-3">ゆっくり、わかるまで説明します</h2>
      <p class="text-gray-700 leading-relaxed">
        「こんなことを聞いてもいいのかな」と遠慮しないでください。
        どんな小さなことでもお気軽にご相談ください。
        専門用語を使わず、わかりやすい言葉でご説明します。
        また、ご家族の方からのご依頼も大歓迎です。
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">よくあるサポート内容</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { title: 'メール設定・使い方', desc: 'Outlookやメーラーのアカウント設定、送受信の方法をわかりやすくご説明。' },
          { title: 'Zoom・ビデオ通話設定', desc: 'お孫さんとビデオ通話できるよう、Zoomのインストールから使い方まで対応。' },
          { title: '文字サイズ・画面設定', desc: '文字を大きくする・マウスの速さを遅くするなど使いやすい設定に変更。' },
          { title: '詐欺対策・セキュリティ', desc: '偽警告が出ないようにブラウザ設定を変更し、見分け方もご説明します。' },
          { title: 'プリンター設定', desc: 'プリンターが急に使えなくなった・新しいプリンターをつなぎたい。' },
          { title: '写真の整理・保存', desc: 'スマートフォンの写真をパソコンに移したい・アルバムを作りたい。' },
        ].map(item => (
          <div class="bg-gray-50 rounded-xl p-4">
            <div class="font-bold text-gray-800 mb-1">{item.title}</div>
            <div class="text-sm text-gray-600 leading-relaxed">{item.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">料金目安</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100">
              <th class="text-left px-4 py-3 rounded-tl-lg font-bold text-gray-700">サポート内容</th>
              <th class="text-right px-4 py-3 rounded-tr-lg font-bold text-gray-700">目安料金</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['基本操作サポート（1時間）', '3,000円〜'],
              ['メール・Zoom設定', '5,000円〜'],
              ['セキュリティ設定・詐欺対策', '5,000円〜'],
              ['出張費', '2,000円（宇佐市内）、その他の地域 4,000円～'],
            ].map(([label, price], i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-4 py-3 text-gray-700 border-t border-gray-100">{label}</td>
                <td class="px-4 py-3 text-right font-medium text-gray-900 border-t border-gray-100">{price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-400 mt-2">※ 内容・時間により異なります。まずはご相談ください。</p>
    </section>

    <CallToAction
      heading="遠慮なくお声がけください"
      subtext="お子さんからのご依頼も歓迎。親御さんのパソコンをサポートします。"
    />

  </article>
</Layout>
