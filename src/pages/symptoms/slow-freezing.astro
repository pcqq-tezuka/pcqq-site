---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CallToAction from '../../components/CallToAction.astro';
---

<Layout
  title="パソコンが遅い・固まる | PCQQ パソコン修理"
  description="起動に何分もかかる・操作中にフリーズする・重い。パソコンが遅くなる原因とSSD換装による速度改善。大分県宇佐市・別府・中津の出張修理はPCQQへ。"
>
  <article class="max-w-3xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: '困った症状から探す', href: '/symptoms' },
      { label: '動きが遅い・固まる' },
    ]} />

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-3 mb-2">
      動きが遅い・固まる
    </h1>
    <p class="text-gray-500 mb-8">起動に時間がかかる・操作中にフリーズ・全体的に重い</p>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">こんな状態ではありませんか？</h2>
      <ul class="space-y-2">
        {[
          '電源を入れてから使えるまで10分以上かかる',
          '操作中に突然固まって、しばらく動かなくなる',
          'インターネットを開くだけでもものすごく遅い',
          '以前は普通だったのに最近急に重くなった',
          '複数のウィンドウを開くと動かなくなる',
        ].map(item => (
          <li class="flex items-start gap-2 text-gray-700">
            <span class="text-blue-500 mt-0.5 shrink-0">✓</span>
            {item}
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">考えられる原因</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { title: 'HDDの老化・劣化', desc: '最も多い原因。HDDは5〜7年で読み書き速度が低下。SSDに換装すると劇的に速くなる。' },
          { title: 'メモリ不足', desc: '4GB以下のメモリでは現代のWindowsには不足。増設で改善することも。' },
          { title: 'ウイルス・マルウェア', desc: '裏で動くウイルスがCPUやメモリを食い尽くして遅くなるケースも多い。' },
          { title: 'スタートアップの肥大化', desc: 'インストールしたソフトが多すぎると起動が遅くなる。不要なものを整理。' },
        ].map(item => (
          <div class="bg-gray-50 rounded-xl p-4">
            <div class="font-bold text-gray-800 mb-1">{item.title}</div>
            <div class="text-sm text-gray-600 leading-relaxed">{item.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- SSD換装のすすめ -->
    <section class="mb-10 bg-indigo-50 border border-indigo-100 rounded-2xl p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-3">SSD換装で劇的に速くなります</h2>
      <p class="text-gray-700 text-sm leading-relaxed mb-4">
        古いHDDからSSDに交換すると、起動時間が<strong>10分→30秒</strong>になるケースも珍しくありません。
        新しいパソコンを買わなくても、SSD換装で「新品同様の速さ」を取り戻せます。
      </p>
      <div class="grid grid-cols-2 gap-3 text-center text-sm">
        <div class="bg-white rounded-xl p-3">
          <div class="text-gray-400 mb-1">HDD（古いまま）</div>
          <div class="text-2xl font-bold text-gray-400">🐢 遅い</div>
          <div class="text-gray-500">起動: 5〜15分</div>
        </div>
        <div class="bg-white rounded-xl p-3 border-2 border-indigo-300">
          <div class="text-indigo-600 font-bold mb-1">SSD換装後</div>
          <div class="text-2xl font-bold text-indigo-600">🚀 速い</div>
          <div class="text-indigo-700 font-medium">起動: 30秒〜1分</div>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">料金目安</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100">
              <th class="text-left px-4 py-3 rounded-tl-lg font-bold text-gray-700">作業内容</th>
              <th class="text-right px-4 py-3 rounded-tr-lg font-bold text-gray-700">目安料金</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['SSD換装＋データ移行＋OS再インストール', '20,000円〜'],
              ['ウイルス除去・最適化', '8,000円〜'],
              ['スタートアップ整理・設定最適化', '5,000円〜'],
              ['出張費', '2,000円（宇佐市内）、その他の地域 4,000円～'],
            ].map(([label, price], i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-4 py-3 text-gray-700 border-t border-gray-100">{label}</td>
                <td class="px-4 py-3 text-right font-medium text-gray-900 border-t border-gray-100">{price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-400 mt-2">※ SSD容量・機種により異なります。まずはご相談ください。</p>
    </section>

    <CallToAction
      heading="買い替えの前にご相談を"
      subtext="SSD換装で新品同様の速さに。出張対応・相談無料。"
    />

  </article>
</Layout>
