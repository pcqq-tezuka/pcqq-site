---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CallToAction from '../../components/CallToAction.astro';
---

<Layout
  title="変な警告が出た・サポート詐欺 | PCQQ パソコン修理"
  description="「ウイルスに感染しました」「Microsoftに電話してください」などの警告が消えない。絶対に電話しないでください。大分県宇佐市のPCQQが安全に対処します。"
>
  <article class="max-w-3xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: '困った症状から探す', href: '/symptoms' },
      { label: '変な警告が出た' },
    ]} />

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-3 mb-2">
      変な警告が出た・画面が消えない
    </h1>
    <p class="text-gray-500 mb-8">「ウイルスに感染」「今すぐ電話を」などの警告はサポート詐欺です</p>

    <!-- 警告 -->
    <div class="bg-red-50 border border-red-200 rounded-2xl p-5 mb-8">
      <div class="flex items-start gap-3">
        <span class="text-2xl shrink-0">🚨</span>
        <div>
          <div class="font-bold text-red-700 mb-1">絶対に電話しないでください</div>
          <p class="text-sm text-red-600 leading-relaxed">
            画面に表示された電話番号に電話すると、遠隔操作ソフトをインストールされ
            個人情報や銀行口座を盗まれる被害が急増しています。
            まず電源を切り、PCQQにご連絡ください。
          </p>
        </div>
      </div>
    </div>

    <!-- こんな画面ではありませんか？ -->
    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">こんな画面ではありませんか？</h2>
      <ul class="space-y-2">
        {[
          '「ウイルスに感染しました。今すぐ○○に電話してください」',
          '「Microsoftセキュリティ警告」と大きく表示される',
          '警告音（ビープ音）が鳴り続けて消えない',
          '突然全画面で警告が出て操作できなくなった',
          '「あなたのIPアドレスが不正アクセスされています」',
        ].map(item => (
          <li class="flex items-start gap-2 text-gray-700">
            <span class="text-red-400 mt-0.5 shrink-0">!</span>
            {item}
          </li>
        ))}
      </ul>
      <p class="mt-4 text-sm text-gray-600 bg-gray-50 rounded-xl p-3">
        これらはすべて<strong>偽の警告（サポート詐欺）</strong>です。MicrosoftやWindowsが突然このような警告を出すことは絶対にありません。
      </p>
    </section>

    <!-- まず取るべき行動 -->
    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">まず取るべき行動</h2>
      <ol class="space-y-3">
        {[
          { step: '電話しない', desc: '画面に表示された番号には絶対に電話しないでください。' },
          { step: 'パソコンの電源を切る', desc: '画面が消えない場合は電源ボタンを長押しして強制終了してください。' },
          { step: 'PCQQに連絡', desc: '強制終了出来なくても構わないのでPCQQにご連絡ください。' },
        ].map((item, i) => (
          <li class="flex items-start gap-3">
            <span class="bg-blue-600 text-white text-sm font-bold rounded-full w-6 h-6 flex items-center justify-center shrink-0 mt-0.5">{i + 1}</span>
            <div>
              <div class="font-bold text-gray-800">{item.step}</div>
              <div class="text-sm text-gray-600">{item.desc}</div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- もし電話してしまったら -->
    <section class="mb-10 bg-yellow-50 border border-yellow-200 rounded-2xl p-5">
      <h2 class="text-lg font-bold text-gray-900 mb-3">もし電話してしまった・遠隔操作された場合</h2>
      <ul class="space-y-2 text-sm text-gray-700">
        {[
          'すぐにインターネットを切断（Wi-FiをOFF、またはLANケーブルを抜く）',
          '銀行・クレジットカード会社に連絡して不正利用を停止',
          '警察・消費者ホットライン（188）に相談',
          'PCQQに連絡。遠隔操作ソフトの削除・安全確認を行います',
        ].map(item => (
          <li class="flex items-start gap-2">
            <span class="text-yellow-600 mt-0.5 shrink-0">→</span>
            {item}
          </li>
        ))}
      </ul>
    </section>

    <!-- PCQQの対応 -->
    <section class="mb-10 bg-blue-50 rounded-2xl p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-3">PCQQの対応</h2>
      <ul class="space-y-2 text-gray-700">
        {[
          '偽警告の原因となったウイルス・マルウェアを完全除去',
          '遠隔操作ソフトが入っていないか確認・削除',
          'セキュリティソフトの見直し・設定',
          '再発防止のためのブラウザ設定変更',
        ].map(item => (
          <li class="flex items-start gap-2">
            <span class="text-blue-500 mt-0.5 shrink-0">✓</span>
            {item}
          </li>
        ))}
      </ul>
    </section>

    <CallToAction
      heading="不安なままにしないでください"
      subtext="「電話してしまった」という場合もお気軽にご連絡を。一緒に対処します。"
    />

  </article>
</Layout>
