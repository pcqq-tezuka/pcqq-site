---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CallToAction from '../../components/CallToAction.astro';
---

<Layout
  title="ネットが繋がらない | PCQQ パソコン修理"
  description="Wi-Fiが繋がらない・急にインターネットが使えなくなった。原因の特定から設定まで出張対応。大分県宇佐市・別府・中津のパソコン修理はPCQQへ。"
>
  <article class="max-w-3xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: '困った症状から探す', href: '/symptoms' },
      { label: 'ネットが繋がらない' },
    ]} />

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-3 mb-2">
      ネットが繋がらない
    </h1>
    <p class="text-gray-500 mb-8">Wi-Fiが繋がらない・急にインターネットが使えなくなった</p>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">こんな状態ではありませんか？</h2>
      <ul class="space-y-2">
        {[
          '急にネットに繋がらなくなった',
          'Wi-Fiのアイコンに×マークや△マークが出ている',
          'スマホは繋がるのにパソコンだけ繋がらない',
          'ルーターのランプが赤くなっている',
          '引っ越し後にネットの設定がわからない',
          'プロバイダを変えたら繋がらなくなった',
        ].map(item => (
          <li class="flex items-start gap-2 text-gray-700">
            <span class="text-blue-500 mt-0.5 shrink-0">✓</span>
            {item}
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">考えられる原因</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { title: 'ルーター・モデムの不具合', desc: '再起動で直ることも多いが、機器の故障や設定リセットが必要な場合も。' },
          { title: 'Wi-Fiドライバーの問題', desc: 'Windows更新後にドライバーが壊れてWi-Fiが使えなくなることがある。' },
          { title: 'ネットワーク設定の誤り', desc: 'IPアドレスやDNSの設定が崩れていると繋がらなくなる。' },
          { title: 'プロバイダ側の障害', desc: 'まれにプロバイダ側の障害で繋がらないことも。確認と切り分けが必要。' },
        ].map(item => (
          <div class="bg-gray-50 rounded-xl p-4">
            <div class="font-bold text-gray-800 mb-1">{item.title}</div>
            <div class="text-sm text-gray-600 leading-relaxed">{item.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-10 bg-blue-50 rounded-2xl p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">PCQQの対応</h2>
      <ol class="space-y-3">
        {[
          '出張してルーター・パソコン・回線の状態を確認',
          '原因の特定（パソコン側かルーター側か回線側か）',
          'ドライバーの再インストール・ネットワーク設定の修正',
          '必要に応じてルーターの設定変更・再設定',
          '接続確認後、安定して使えるまでサポート',
        ].map((item, i) => (
          <li class="flex items-start gap-3 text-gray-700">
            <span class="bg-blue-600 text-white text-sm font-bold rounded-full w-6 h-6 flex items-center justify-center shrink-0 mt-0.5">{i + 1}</span>
            {item}
          </li>
        ))}
      </ol>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">料金目安</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100">
              <th class="text-left px-4 py-3 rounded-tl-lg font-bold text-gray-700">作業内容</th>
              <th class="text-right px-4 py-3 rounded-tr-lg font-bold text-gray-700">目安料金</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['ネット接続設定・診断', '5,000円〜'],
              ['ドライバー再インストール', '5,000円〜'],
              ['ルーター設定・Wi-Fi設定', '5,000円〜'],
              ['出張費', '2,000円（宇佐市内）、その他の地域 4,000円～'],
            ].map(([label, price], i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-4 py-3 text-gray-700 border-t border-gray-100">{label}</td>
                <td class="px-4 py-3 text-right font-medium text-gray-900 border-t border-gray-100">{price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-400 mt-2">※ 状況により異なります。まずはご相談ください。</p>
    </section>

    <CallToAction
      heading="ネット不通はお早めに"
      subtext="出張で原因を特定・その場で解決します。相談無料。"
    />

  </article>
</Layout>
