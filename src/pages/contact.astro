---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const PHONE = '050-3159-9587';
const PHONE_TEL = 'tel:05031599587';
const LINE_URL = 'http://line.me/ti/p/%40cbe1836f';
---

<Layout
  title="お問い合わせ | PCQQ パソコン修理"
  description="PCQQパソコン修理へのお問い合わせ。電話・LINE・メールフォームでお気軽にご連絡ください。大分県宇佐市・別府・中津の出張修理。相談無料。"
>
  <div class="max-w-2xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: 'お問い合わせ' },
    ]} />

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-3 mb-2">お問い合わせ</h1>
    <p class="text-gray-500 mb-8">相談・見積もりは無料です。お気軽にご連絡ください。</p>

    <!-- 電話・LINE -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
      <a
        href={PHONE_TEL}
        class="flex flex-col items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl p-6 transition-colors text-center"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <div>
          <div class="text-xs opacity-80 mb-0.5">電話で相談する</div>
          <div class="text-lg font-bold tracking-wide">{PHONE}</div>
          <div class="text-xs opacity-70 mt-0.5">受付 9:00〜20:00</div>
        </div>
      </a>

      <a
        href={LINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white rounded-2xl p-6 transition-colors text-center"
      >
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.105.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.070 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
        </svg>
        <div>
          <div class="text-xs opacity-80 mb-0.5">LINEで相談する</div>
          <div class="text-base font-bold">@PCQQ</div>
          <div class="text-xs opacity-70 mt-0.5">24時間受付・返信は翌営業日</div>
        </div>
      </a>
    </div>

    <!-- フォーム -->
    <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm">
      <h2 class="text-lg font-bold text-gray-900 mb-5">メールフォーム</h2>

      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/contact/thanks"
        class="space-y-5"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1" for="name">
            お名前 <span class="text-red-500 text-xs">必須</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="山田 太郎"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100 transition"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1" for="phone">
            電話番号
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            placeholder="090-0000-0000"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100 transition"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1" for="email">
            メールアドレス
          </label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="example@email.com"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100 transition"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1" for="area">
            お住まいのエリア
          </label>
          <input
            type="text"
            id="area"
            name="area"
            placeholder="例：宇佐市 四日市"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100 transition"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1" for="message">
            お問い合わせ内容 <span class="text-red-500 text-xs">必須</span>
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows={5}
            placeholder="パソコンの症状・お困りの内容をお教えください"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100 transition resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition-colors text-sm"
        >
          送信する
        </button>
      </form>
    </div>

    <p class="text-xs text-gray-400 mt-4 text-center">
      ※ 返信は翌営業日以内を目安にご連絡します。<br />
      ※ 急ぎの場合はお電話またはLINEをご利用ください。
    </p>

  </div>
</Layout>
