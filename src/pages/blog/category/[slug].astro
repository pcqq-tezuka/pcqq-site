---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CategoryBadge from '../../../components/CategoryBadge.astro';
import { getAllBlogs, getBlogsByCategory, formatDate, extractExcerpt, getCategorySlug, getPostSlug, CATEGORY_META } from '../../../lib/microcms';
import type { BlogPost } from '../../../lib/microcms';

const CATEGORY_DESCRIPTIONS: Record<string, string> = {
  scam: 'サポート詐欺の手口・対策・実例をわかりやすく解説します。',
  case: '実際の修理・トラブル対応事例を紹介します。',
  tips: 'パソコンの使い方やトラブル解決のヒントを紹介します。',
  news:        'PCQQからのお知らせです。',
  information: 'PCQQからのお知らせです。',
};

export const getStaticPaths: GetStaticPaths = async () => {
  try {
    const data = await getAllBlogs();
    // 記事データからカテゴリを収集（contentId と slug の対応を取得）
    const categoryMap = new Map<string, { contentId: string; label: string }>();
    for (const post of data.contents) {
      if (post.category && typeof post.category === 'object' && post.category.slug) {
        categoryMap.set(post.category.slug, {
          contentId: post.category.id,
          label: post.category.name,
        });
      }
    }
    return [...categoryMap.entries()].map(([slug, cat]) => ({
      params: { slug },
      props:  { categoryContentId: cat.contentId, categoryLabel: cat.label },
    }));
  } catch (e) {
    console.warn('[blog/category] microCMS取得失敗:', e);
    return [];
  }
};

interface Props {
  categoryContentId: string;
  categoryLabel: string;
}
const { slug } = Astro.params;
const { categoryContentId, categoryLabel } = Astro.props;

const info = {
  label: categoryLabel ?? CATEGORY_META[slug!]?.label ?? slug!,
  description: CATEGORY_DESCRIPTIONS[slug!] ?? '',
};

let posts: BlogPost[] = [];
let totalCount = 0;

try {
  const data = await getBlogsByCategory(categoryContentId, 20);
  posts      = data.contents;
  totalCount = data.totalCount;
} catch (e) {
  console.warn(`[blog/category/${slug}] microCMS取得失敗:`, e);
}
---

<Layout
  title={`${info?.label ?? slug} | ブログ`}
  description={info?.description ?? ''}
>
  <div class="max-w-5xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: 'ブログ', href: '/blog' },
      { label: info?.label ?? slug! },
    ]} />

    <div class="flex items-center gap-3 mt-2 mb-2">
      <CategoryBadge slug={slug} />
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900">
        {info?.label ?? slug}
      </h1>
    </div>
    <p class="text-gray-500 mb-10">
      {info?.description}
      {totalCount > 0 && `（${totalCount}件）`}
    </p>

    {posts.length === 0 ? (
      <div class="text-center py-20 text-gray-400">
        <p class="text-lg">このカテゴリの記事はまだありません。</p>
        <a href="/blog" class="mt-4 inline-block text-blue-600 hover:text-blue-700 font-medium">
          ← ブログ一覧へ
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {posts.map(post => {
          const excerpt = post.excerpt ?? extractExcerpt(post.body);
          const catSlug = getCategorySlug(post.category);
          const postSlug = getPostSlug(post);
          return (
            <article class="flex flex-col bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
              {/* サムネイル */}
              <a href={`/blog/${postSlug}`} class="block" tabindex="-1" aria-hidden="true">
                {post.thumbnail ? (
                  <img
                    src={`${post.thumbnail.url}?w=640&h=360&fit=crop&auto=format`}
                    alt={post.title}
                    width="640"
                    height="360"
                    class="w-full aspect-video object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full aspect-video bg-gradient-to-br from-blue-100 to-indigo-200 flex items-center justify-center">
                    <svg class="w-12 h-12 text-blue-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <path d="M3 9h18M9 21V9" stroke-linecap="round"/>
                    </svg>
                  </div>
                )}
              </a>

              {/* テキスト */}
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <CategoryBadge slug={catSlug} />
                  <time datetime={post.publishedAt} class="text-xs text-gray-400">
                    {formatDate(post.publishedAt)}
                  </time>
                </div>
                <h2 class="font-bold text-gray-900 text-lg leading-snug mb-3">
                  <a href={`/blog/${postSlug}`} class="hover:text-blue-600 transition-colors">
                    {post.title}
                  </a>
                </h2>
                <p class="text-sm text-gray-600 leading-relaxed flex-1">{excerpt}</p>
                <a
                  href={`/blog/${postSlug}`}
                  class="mt-5 inline-flex items-center gap-1 text-blue-600 hover:text-blue-700 text-sm font-semibold transition-colors"
                >
                  続きを読む
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 18l6-6-6-6"/>
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    )}

  </div>
</Layout>
