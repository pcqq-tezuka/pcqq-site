---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CallToAction from '../../components/CallToAction.astro';
import {
  getAllBlogs,
  formatDate,
  getOgImageUrl,
  getPostSlug,
  CATEGORY_META,
} from '../../lib/microcms';
import type { BlogPost } from '../../lib/microcms';
import CategoryBadge from '../../components/CategoryBadge.astro';

// ─── SSG: 全記事パスを生成 ────────────────────────────────────
export const getStaticPaths: GetStaticPaths = async () => {
  try {
    const data = await getAllBlogs();
    return data.contents.map(post => ({
      params: { slug: getPostSlug(post) },
      props:  { post },
    }));
  } catch (e) {
    console.warn('[blog/[slug]] microCMS取得失敗:', e);
    return [];
  }
};

// ─── Props ────────────────────────────────────────────────────
interface Props {
  post: BlogPost;
}
const { post } = Astro.props;

const ogImage = getOgImageUrl(post.thumbnail);

const categorySlug = typeof post.category === 'string'
  ? post.category
  : post.category?.slug;
const categoryName = categorySlug ? CATEGORY_META[categorySlug]?.label : undefined;
---

<Layout
  title={post.title}
  description={post.excerpt ?? post.title}
  ogImage={ogImage}
  ogType="article"
>
  <article class="max-w-3xl mx-auto px-4 py-10">

    <!-- パンくずリスト -->
    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: 'ブログ', href: '/blog' },
      ...(categorySlug && categoryName
        ? [{ label: categoryName, href: `/blog/category/${categorySlug}` }]
        : []),
      { label: post.title },
    ]} />

    <!-- アイキャッチ画像 -->
    {post.thumbnail && (
      <div class="mt-4 mb-8 rounded-2xl overflow-hidden shadow-md">
        <img
          src={`${post.thumbnail.url}?w=900&auto=format`}
          alt={post.title}
          width={post.thumbnail.width}
          height={post.thumbnail.height}
          class="w-full object-cover"
          loading="eager"
        />
      </div>
    )}

    <!-- ヘッダー -->
    <header class="mb-8 mt-4">
      <div class="flex items-center gap-3 mb-3">
        <CategoryBadge slug={categorySlug} />
        <time datetime={post.publishedAt} class="text-sm text-gray-400">
          {formatDate(post.publishedAt)}
          {post.revisedAt !== post.publishedAt && (
            <span class="ml-3 text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded">
              更新: {formatDate(post.revisedAt)}
            </span>
          )}
        </time>
      </div>
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900 leading-snug">
        {post.title}
      </h1>
    </header>

    <!-- 本文（microCMSのリッチテキストHTML） -->
    <div
      class="prose prose-lg prose-gray max-w-none
             prose-headings:font-bold prose-headings:text-gray-900
             prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline
             prose-img:rounded-xl prose-img:shadow-sm
             prose-code:bg-gray-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:before:content-none prose-code:after:content-none"
      set:html={post.body}
    />

    <!-- 区切り -->
    <hr class="my-12 border-gray-200" />

    <!-- ブログ一覧へ戻る -->
    <div class="flex justify-between items-center mb-12">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-gray-600 hover:text-blue-600 font-medium transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
        ブログ一覧へ戻る
      </a>
    </div>

    <!-- CTA -->
    <CallToAction category={categorySlug} />

  </article>
</Layout>

<style is:global>
  /* microCMS のコードブロック（<pre><code>）を見やすく */
  .prose pre {
    background-color: #1e293b;
    color: #f1f5f9;
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .prose pre code {
    background-color: transparent !important;
    color: inherit !important;
    padding: 0 !important;
    border-radius: 0 !important;
    font-size: inherit !important;
    font-weight: 400;
  }
</style>
