---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getBlogList, formatDate, extractExcerpt } from '../../lib/microcms';
import type { BlogPost } from '../../lib/microcms';

let posts: BlogPost[] = [];
let totalCount = 0;

try {
  const data = await getBlogList(20);
  posts      = data.contents;
  totalCount = data.totalCount;
} catch (e) {
  console.warn('[blog/index] microCMS取得失敗:', e);
}
---

<Layout
  title="ブログ"
  description="PCQQ パソコン修理のブログ。修理事例・お役立ち情報・サポート詐欺の見分け方など、大分県の皆さんに役立つ情報を発信しています。"
>
  <div class="max-w-5xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: 'ブログ' },
    ]} />

    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2 mt-2">
      ブログ
    </h1>
    <p class="text-gray-500 mb-10">
      修理事例・お役立ち情報 {totalCount > 0 && `（${totalCount}件）`}
    </p>

    {posts.length === 0 ? (
      <div class="text-center py-20 text-gray-400">
        <p class="text-lg">記事はまだありません。</p>
        <a href="/" class="mt-4 inline-block text-blue-600 hover:text-blue-700 font-medium">
          ← トップページへ
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {posts.map(post => {
          const excerpt = post.excerpt ?? extractExcerpt(post.content);
          return (
            <article class="flex flex-col bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
              {/* サムネイル */}
              <a href={`/blog/${post.id}`} class="block" tabindex="-1" aria-hidden="true">
                {post.eyecatch ? (
                  <img
                    src={`${post.eyecatch.url}?w=640&h=360&fit=crop&auto=format`}
                    alt={post.title}
                    width="640"
                    height="360"
                    class="w-full aspect-video object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full aspect-video bg-gradient-to-br from-blue-100 to-indigo-200 flex items-center justify-center">
                    <svg class="w-12 h-12 text-blue-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <path d="M3 9h18M9 21V9" stroke-linecap="round"/>
                    </svg>
                  </div>
                )}
              </a>

              {/* テキスト */}
              <div class="p-6 flex flex-col flex-1">
                <time
                  datetime={post.publishedAt}
                  class="text-xs text-gray-400 mb-2"
                >
                  {formatDate(post.publishedAt)}
                </time>
                <h2 class="font-bold text-gray-900 text-lg leading-snug mb-3">
                  <a href={`/blog/${post.id}`} class="hover:text-blue-600 transition-colors">
                    {post.title}
                  </a>
                </h2>
                <p class="text-sm text-gray-600 leading-relaxed flex-1">{excerpt}</p>
                <a
                  href={`/blog/${post.id}`}
                  class="mt-5 inline-flex items-center gap-1 text-blue-600 hover:text-blue-700 text-sm font-semibold transition-colors"
                >
                  続きを読む
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 18l6-6-6-6"/>
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    )}

  </div>
</Layout>
