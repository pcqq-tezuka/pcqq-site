---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CallToAction from '../../components/CallToAction.astro';
---

<Layout
  title="液晶・画面修理 | PCQQ パソコン修理"
  description="ノートパソコンの液晶が割れた・映らない・暗い。液晶パネル交換に対応。大分県宇佐市・別府・中津の出張パソコン修理PCQQへ。"
>
  <article class="max-w-3xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: 'サービス一覧', href: '/services' },
      { label: '液晶・画面修理' },
    ]} />

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-3 mb-2">液晶・画面修理</h1>
    <p class="text-gray-500 mb-8">割れた・映らない・暗い。液晶パネルを新品に交換します</p>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">こんな症状に対応します</h2>
      <ul class="space-y-2">
        {[
          '液晶が割れてひびが入っている',
          '画面が真っ暗で何も映らない',
          '画面がちらつく・縞模様が出ている',
          '画面の一部が白くなっている',
          '落としてから画面が映らなくなった',
          '画面がとても暗くて見づらい（バックライト切れ）',
        ].map(item => (
          <li class="flex items-start gap-2 text-gray-700">
            <span class="text-blue-500 mt-0.5 shrink-0">✓</span>{item}
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-10 bg-blue-50 rounded-2xl p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">作業内容</h2>
      <ol class="space-y-3">
        {[
          '機種・型番を確認し、対応する液晶パネルを手配',
          '液晶パネルを交換（データには一切触れません）',
          '画面の映り・タッチパネルの動作確認',
          'その場でお渡し（パーツ在庫状況により即日〜数日）',
        ].map((item, i) => (
          <li class="flex items-start gap-3 text-gray-700">
            <span class="bg-blue-600 text-white text-sm font-bold rounded-full w-6 h-6 flex items-center justify-center shrink-0 mt-0.5">{i + 1}</span>
            {item}
          </li>
        ))}
      </ol>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">料金目安</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100">
              <th class="text-left px-4 py-3 rounded-tl-lg font-bold text-gray-700">作業内容</th>
              <th class="text-right px-4 py-3 rounded-tr-lg font-bold text-gray-700">目安料金</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['液晶パネル交換（パーツ代込み）', '15,000円〜'],
              ['出張費', '無料（宇佐市内）'],
            ].map(([label, price], i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-4 py-3 text-gray-700 border-t border-gray-100">{label}</td>
                <td class="px-4 py-3 text-right font-medium text-gray-900 border-t border-gray-100">{price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-400 mt-2">※ 機種・パネルサイズにより異なります。まずはご相談ください。</p>
    </section>

    <CallToAction heading="割れた液晶もご相談ください" subtext="機種を教えていただければ概算をお伝えできます。相談無料。" />
  </article>
</Layout>
