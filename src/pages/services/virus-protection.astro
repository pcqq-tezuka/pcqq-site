---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CallToAction from '../../components/CallToAction.astro';
---

<Layout
  title="ウイルス対策・セキュリティ | PCQQ パソコン修理"
  description="ウイルス除去・マルウェア対策・セキュリティソフト設定。偽警告・不審な動作の原因調査も対応。大分県宇佐市・別府・中津の出張修理PCQQへ。"
>
  <article class="max-w-3xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: 'サービス一覧', href: '/services' },
      { label: 'ウイルス対策・セキュリティ' },
    ]} />

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-3 mb-2">ウイルス対策・セキュリティ</h1>
    <p class="text-gray-500 mb-8">ウイルス除去から再発防止まで。安心して使える環境に整えます</p>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">こんな症状はウイルスかもしれません</h2>
      <ul class="space-y-2">
        {[
          '突然動きが遅くなった・重くなった',
          '見覚えのないソフトがインストールされている',
          'ブラウザのホームページが勝手に変わった',
          '広告がやたらと出てくる',
          '偽のセキュリティ警告が繰り返し出る',
          'パソコンが勝手に操作されている気がする',
        ].map(item => (
          <li class="flex items-start gap-2 text-gray-700">
            <span class="text-red-400 mt-0.5 shrink-0">!</span>{item}
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">作業内容</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { title: 'ウイルス・マルウェア除去', desc: '複数の専用ツールを使って徹底的にスキャン・除去します。' },
          { title: 'セキュリティソフト設定', desc: '信頼できるセキュリティソフトを導入・設定します。' },
          { title: '不審なソフトの削除', desc: '知らない間にインストールされたソフトを調査・削除します。' },
          { title: '再発防止設定', desc: 'ブラウザの設定変更・Windows Updateの確認など再感染を防ぎます。' },
        ].map(item => (
          <div class="bg-gray-50 rounded-xl p-4">
            <div class="font-bold text-gray-800 mb-1">{item.title}</div>
            <div class="text-sm text-gray-600 leading-relaxed">{item.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">料金目安</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100">
              <th class="text-left px-4 py-3 rounded-tl-lg font-bold text-gray-700">作業内容</th>
              <th class="text-right px-4 py-3 rounded-tr-lg font-bold text-gray-700">目安料金</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['ウイルス除去・セキュリティ強化', '8,000円〜'],
              ['セキュリティソフト導入・設定', '3,000円〜'],
              ['出張費', '2,000円（宇佐市内）、その他の地域 4,000円～'],
            ].map(([label, price], i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-4 py-3 text-gray-700 border-t border-gray-100">{label}</td>
                <td class="px-4 py-3 text-right font-medium text-gray-900 border-t border-gray-100">{price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <CallToAction heading="おかしいと思ったらすぐご相談を" subtext="放置すると個人情報漏洩のリスクも。出張・相談無料。" />
  </article>
</Layout>
