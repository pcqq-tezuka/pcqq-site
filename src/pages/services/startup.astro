---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CallToAction from '../../components/CallToAction.astro';
---

<Layout
  title="起動・動作改善 | PCQQ パソコン修理"
  description="起動しない・遅い・フリーズするパソコンを修理します。OS修復・ドライバー更新・不要ソフト削除まで。大分県宇佐市・別府・中津の出張修理はPCQQへ。"
>
  <article class="max-w-3xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: 'サービス一覧', href: '/services' },
      { label: '起動・動作改善' },
    ]} />

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-3 mb-2">起動・動作改善</h1>
    <p class="text-gray-500 mb-8">起動しない・遅い・フリーズするを解決します</p>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">こんなお悩みに対応します</h2>
      <ul class="space-y-2">
        {[
          'Windowsが起動しない・ロゴで止まる',
          '電源を入れてから使えるまで10分以上かかる',
          '操作中に突然固まってしまう',
          'Windows更新後から調子が悪くなった',
          '「自動修復」の画面でループしている',
        ].map(item => (
          <li class="flex items-start gap-2 text-gray-700">
            <span class="text-blue-500 mt-0.5 shrink-0">✓</span>{item}
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">作業内容</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { title: 'OS・システム修復', desc: 'Windowsのシステムファイルを修復し、起動できる状態に戻します。' },
          { title: 'ドライバー更新・修正', desc: '更新後に壊れたドライバーを正常なものに戻します。' },
          { title: 'スタートアップ最適化', desc: '不要な常駐ソフトを整理し、起動・動作を軽くします。' },
          { title: 'OS再インストール', desc: '修復が難しい場合はクリーンインストール。データ移行も対応。' },
        ].map(item => (
          <div class="bg-gray-50 rounded-xl p-4">
            <div class="font-bold text-gray-800 mb-1">{item.title}</div>
            <div class="text-sm text-gray-600 leading-relaxed">{item.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">料金目安</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100">
              <th class="text-left px-4 py-3 rounded-tl-lg font-bold text-gray-700">作業内容</th>
              <th class="text-right px-4 py-3 rounded-tr-lg font-bold text-gray-700">目安料金</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['システム修復・動作改善', '8,000円〜'],
              ['OS再インストール＋データ移行', '15,000円〜'],
              ['出張費', '2,000円（宇佐市内）、その他の地域 4,000円～'],
            ].map(([label, price], i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-4 py-3 text-gray-700 border-t border-gray-100">{label}</td>
                <td class="px-4 py-3 text-right font-medium text-gray-900 border-t border-gray-100">{price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-400 mt-2">※ 状態により異なります。まずはご相談ください。</p>
    </section>

    <CallToAction heading="起動しなくてもご相談ください" subtext="出張診断無料。まずお電話を。" />
  </article>
</Layout>
