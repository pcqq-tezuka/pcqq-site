---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CallToAction from '../../components/CallToAction.astro';
---

<Layout
  title="デジタル遺品整理 | PCQQ パソコン修理"
  description="故人のパソコン・スマホのデータ整理、アカウント削除、大切な写真の取り出しに対応。大分県宇佐市のPCQQが丁寧に対応します。"
>
  <article class="max-w-3xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: 'サービス一覧', href: '/services' },
      { label: 'デジタル遺品整理' },
    ]} />

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-3 mb-2">デジタル遺品整理</h1>
    <p class="text-gray-500 mb-8">故人のPC・スマホのデータを丁寧に整理・引き継ぎします</p>

    <!-- ご遺族へのメッセージ -->
    <div class="bg-gray-50 rounded-2xl p-6 mb-10">
      <p class="text-gray-700 leading-relaxed">
        大切な方を亡くされた後、パソコンやスマートフォンの中に残されたデータの整理は
        気力も知識も必要な作業です。
        PCQQでは、ご遺族の気持ちに寄り添いながら、丁寧に対応いたします。
      </p>
    </div>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">こんなことでお困りではありませんか？</h2>
      <ul class="space-y-2">
        {[
          '故人のパソコンのパスワードがわからない',
          '大切な写真・動画を取り出したい',
          'SNSやメールアカウントを削除したい',
          'ネットバンキング・サブスクの解約方法がわからない',
          'パソコンを処分したいが中のデータが心配',
        ].map(item => (
          <li class="flex items-start gap-2 text-gray-700">
            <span class="text-blue-500 mt-0.5 shrink-0">✓</span>{item}
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">対応内容</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { title: 'データの取り出し・保存', desc: '写真・動画・書類などをUSBメモリや外付けHDDに保存します。' },
          { title: 'アカウント整理', desc: 'SNS・メール・サブスクリプションサービスの確認・解約をサポート。' },
          { title: 'データ消去・廃棄準備', desc: '個人情報が漏れないよう、データを完全消去して廃棄できる状態にします。' },
          { title: 'パスワード解除', desc: 'ログインできない端末のパスワード解除（対応できる範囲でご案内）。' },
        ].map(item => (
          <div class="bg-gray-50 rounded-xl p-4">
            <div class="font-bold text-gray-800 mb-1">{item.title}</div>
            <div class="text-sm text-gray-600 leading-relaxed">{item.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">料金目安</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100">
              <th class="text-left px-4 py-3 rounded-tl-lg font-bold text-gray-700">作業内容</th>
              <th class="text-right px-4 py-3 rounded-tr-lg font-bold text-gray-700">目安料金</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['データ取り出し・保存', '12,000円〜'],
              ['データ完全消去', '15,000円〜'],
              ['パスワード解除', '23,000円〜'],
              ['出張費', '2,000円（宇佐市内）、その他の地域 4,000円～'],
            ].map(([label, price], i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-4 py-3 text-gray-700 border-t border-gray-100">{label}</td>
                <td class="px-4 py-3 text-right font-medium text-gray-900 border-t border-gray-100">{price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-400 mt-2">※ 内容・作業量により異なります。まずはご相談ください。</p>
    </section>

    <CallToAction heading="一人で抱え込まないでください" subtext="どんな小さなことでもお気軽にご相談ください。" />
  </article>
</Layout>
