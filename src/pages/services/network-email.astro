---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CallToAction from '../../components/CallToAction.astro';
---

<Layout
  title="ネット・メール設定 | PCQQ パソコン修理"
  description="Wi-Fi設定・メールアカウント設定・プロバイダ変更対応。インターネットが使えない・メールが送れないなどのトラブルを解決。大分県宇佐市のPCQQへ。"
>
  <article class="max-w-3xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: 'サービス一覧', href: '/services' },
      { label: 'ネット・メール設定' },
    ]} />

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-3 mb-2">ネット・メール設定</h1>
    <p class="text-gray-500 mb-8">Wi-Fi接続・メール設定・プロバイダ変更まで出張対応</p>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">こんなお悩みに対応します</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { title: 'ネット接続トラブル', items: ['急に繋がらなくなった', 'スマホは繋がるのにPCだけ繋がらない', 'Wi-Fiに繋がらない'] },
          { title: 'メール設定', items: ['新しいパソコンにメールを移したい', 'メールが送受信できない', 'Outlookの設定がわからない'] },
          { title: '引越し・プロバイダ変更', items: ['引越し後にネットの設定がわからない', 'プロバイダを変えたら繋がらない', 'ルーターを新しくした'] },
          { title: '複数台・複合機設定', items: ['プリンターをWi-Fiで使いたい', '家族のパソコンもまとめて設定したい', 'NASを導入したい'] },
        ].map(group => (
          <div class="bg-gray-50 rounded-xl p-4">
            <div class="font-bold text-gray-800 mb-2">{group.title}</div>
            <ul class="space-y-1">
              {group.items.map(item => (
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="text-blue-400 shrink-0">・</span>{item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">料金目安</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100">
              <th class="text-left px-4 py-3 rounded-tl-lg font-bold text-gray-700">作業内容</th>
              <th class="text-right px-4 py-3 rounded-tr-lg font-bold text-gray-700">目安料金</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['ネット接続設定・トラブル解決', '5,000円〜'],
              ['メールアカウント設定（1アカウント）', '3,000円〜'],
              ['プロバイダ変更・ルーター設定', '5,000円〜'],
              ['出張費', '2,000円（宇佐市内）、その他の地域 4,000円～'],
            ].map(([label, price], i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-4 py-3 text-gray-700 border-t border-gray-100">{label}</td>
                <td class="px-4 py-3 text-right font-medium text-gray-900 border-t border-gray-100">{price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-400 mt-2">※ 内容により異なります。まずはご相談ください。</p>
    </section>

    <CallToAction heading="ネット・メールのお困りごとはPCQQへ" subtext="出張で設定します。相談無料。" />
  </article>
</Layout>
