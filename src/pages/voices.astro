---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CallToAction from '../components/CallToAction.astro';

const voices = [
  {
    name: '宇佐市・70代女性',
    service: 'パソコンが起動しない・SSD換装',
    rating: 5,
    text: '電源を入れても起動しなくなり、大切な写真が消えてしまうと心配で連絡しました。来てもらったその日に直してもらえて、写真も全部残っていました。SSDに交換してもらったら以前より格段に速くなって驚きました。丁寧に説明してくれて安心してお任せできました。',
  },
  {
    name: '宇佐市・50代男性',
    service: 'サポート詐欺・ウイルス除去',
    rating: 5,
    text: '「Microsoftから警告」という画面が出て、表示された番号に電話してしまいました。遠隔操作されてしまい、どうしていいかわからずPCQQさんに連絡。すぐに来てもらって、不正なソフトをすべて削除してもらいました。電話しないようにという注意書きをあとから見て後悔しましたが、手塚さんが冷静に対処してくれて助かりました。',
  },
  {
    name: '豊後高田市・60代女性',
    service: 'メール設定・操作サポート',
    rating: 5,
    text: '新しいパソコンに替えたらメールが使えなくなってしまいました。設定が複雑でどこに頼んでいいかわからなかったのですが、PCQQさんに来てもらってその場で全部解決。操作の仕方も丁寧に教えてもらえて、今では自分でできるようになりました。',
  },
  {
    name: '宇佐市安心院・40代男性',
    service: 'スターリンク導入',
    rating: 5,
    text: '山の中なので光回線が来ておらず、ネットが遅くて仕事に支障が出ていました。スターリンクを勧めてもらい設置してもらったところ、今まで考えられなかったような速さでネットが使えるようになりました。設置から設定まで全部お任せできて本当に助かりました。',
  },
  {
    name: '中津市・80代女性の娘',
    service: '高齢者サポート・Zoom設定',
    rating: 5,
    text: '離れて暮らす母のパソコンが心配で、PCQQさんにお願いしました。Zoomの設定をしてもらい、今では毎週ビデオ通話ができています。母も「わかりやすく教えてもらえた」と喜んでいました。遠方からでも安心してお願いできるサービスです。',
  },
  {
    name: '宇佐市・30代女性',
    service: 'データ復旧',
    rating: 5,
    text: 'パソコンを落としてしまい、子どもの写真が入ったドライブが認識しなくなりました。「もうだめかも」と諦めかけていましたが、PCQQさんに診てもらったら大半のデータが復旧できました。本当に助かりました。料金も事前に説明してもらえて安心でした。',
  },
];
---

<Layout
  title="お客様の声 | PCQQ パソコン修理"
  description="PCQQパソコン修理のお客様の声・口コミ。宇佐市・豊後高田市・中津市など大分県北部のお客様からいただいた感想をご紹介します。"
>
  <div class="max-w-4xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: 'お客様の声' },
    ]} />

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-3 mb-2">お客様の声</h1>
    <p class="text-gray-500 mb-10">ご利用いただいたお客様からいただいた感想をご紹介します。</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {voices.map(v => (
        <article class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm flex flex-col">
          <!-- 星 -->
          <div class="flex gap-0.5 mb-3">
            {Array.from({ length: v.rating }).map(() => (
              <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <!-- テキスト -->
          <p class="text-sm text-gray-700 leading-relaxed flex-1">「{v.text}」</p>
          <!-- 属性 -->
          <div class="mt-4 pt-4 border-t border-gray-50">
            <div class="text-sm font-medium text-gray-800">{v.name}</div>
            <div class="text-xs text-gray-400 mt-0.5">{v.service}</div>
          </div>
        </article>
      ))}
    </div>

    <!-- Googleレビューへのリンク（実装後に差し替え） -->
    <div class="bg-gray-50 rounded-2xl p-6 text-center mb-10">
      <p class="text-sm text-gray-600 mb-3">Googleの口コミもご覧ください</p>
      <a
        href="https://www.google.com/search?q=PCQQ+パソコン修理+宇佐"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-white border border-gray-200 rounded-xl px-5 py-2.5 text-sm font-medium text-gray-700 hover:border-blue-300 transition-colors shadow-sm"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Googleで口コミを見る
      </a>
    </div>

    <CallToAction heading="まずはお気軽にご相談ください" subtext="出張・相談無料。電話またはLINEでお待ちしています。" />

  </div>
</Layout>
