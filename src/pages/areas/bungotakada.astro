---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CallToAction from '../../components/CallToAction.astro';
---

<Layout
  title="豊後高田市のパソコン修理 | PCQQ"
  description="豊後高田市のパソコン出張修理。昭和の街・豊後高田市へ出張します。起動しない・遅い・ウイルス・データ復旧など。PCQQへお気軽にご相談ください。"
>
  <article class="max-w-3xl mx-auto px-4 py-10">

    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: '出張対応エリア', href: '/areas' },
      { label: '豊後高田市' },
    ]} />

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-3 mb-2">
      豊後高田市のパソコン修理
    </h1>
    <p class="text-gray-500 mb-8">昭和の街・豊後高田市へ出張します</p>

    <div class="bg-indigo-50 rounded-2xl p-5 mb-8 flex items-center gap-4">
      <span class="text-3xl shrink-0">📍</span>
      <div>
        <div class="font-bold text-indigo-800">出張料: 4,000円</div>
        <div class="text-sm text-indigo-700">大分県内（宇佐市以外）への出張料は一律4,000円。豊後高田市全域に伺います。</div>
      </div>
    </div>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">対応できる主なトラブル</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {[
          '起動しない・画面が映らない',
          'パソコンが遅い・フリーズする',
          'ウイルス・偽警告の対処',
          'データ復旧・バックアップ',
          'ネット・Wi-Fi設定',
          'メール設定（Outlook等）',
          'SSD換装・高速化',
          '液晶パネル交換',
          '高齢者向けサポート',
          '防犯カメラ設置',
        ].map(item => (
          <div class="flex items-center gap-2 bg-gray-50 rounded-xl px-4 py-2.5 text-sm text-gray-700">
            <span class="text-blue-500 shrink-0">✓</span>{item}
          </div>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">PCQQについて</h2>
      <p class="text-gray-700 leading-relaxed text-sm">
        PCQQは宇佐市を拠点とする個人経営のパソコン修理・サポートサービスです。
        豊後高田市も対応エリアです。「近くに修理屋がない」という方もお気軽にご連絡ください。
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">料金目安</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100">
              <th class="text-left px-4 py-3 rounded-tl-lg font-bold text-gray-700">内容</th>
              <th class="text-right px-4 py-3 rounded-tr-lg font-bold text-gray-700">目安料金</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['出張料', '4,000円'],
              ['トラブル診断', '2,000円（原因が明らかな場合は不要）'],
              ['修理・設定（内容による）', '3,000円〜'],
            ].map(([label, price], i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-4 py-3 text-gray-700 border-t border-gray-100">{label}</td>
                <td class="px-4 py-3 text-right font-medium text-gray-900 border-t border-gray-100">{price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <CallToAction heading="豊後高田市のパソコントラブルはPCQQへ" subtext="相談無料。まずお電話またはLINEでご連絡ください。" />
  </article>
</Layout>
