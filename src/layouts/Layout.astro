---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhoneFloat from '../components/PhoneFloat.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = 'PCQQパソコン修理。宇佐・豊後高田・中津エリア出張対応。困ったことがあれば手塚信哉にご相談ください。',
  ogImage = '/og-default.jpg',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://pcqq.jp';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = title === 'トップ'
  ? 'PCQQ パソコン修理 | 宇佐・豊後高田・中津エリア対応'
  : `${title} | PCQQ パソコン修理`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- ファビコン各種 -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- OGP -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="PCQQ パソコン修理" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NMMQ8BFE8C"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NMMQ8BFE8C');
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-900">
    <!-- スキップリンク（キーボード・スクリーンリーダー向け） -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-blue-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:text-base"
    >
      本文へスキップ
    </a>

    <Header />

    <main id="main-content" class="flex-1 pb-24 md:pb-0">
      <slot />
    </main>

    <Footer />
    <PhoneFloat />
  </body>
</html>
